# --- Database -------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paperpilot

# --- Embeddings: auto | fastembed | hashing -------------------------------------------
# auto = local ONNX model (BAAI/bge-small-en-v1.5) with automatic fallback to hashing
EMBEDDER=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# FASTEMBED_CACHE_DIR=/models

# --- Optional cross-encoder reranker: none | fastembed --------------------------------
RERANKER=none

# --- LLM provider: auto | openai | ollama | extractive ---------------------------------
# auto picks OpenAI if OPENAI_API_KEY is set, else Ollama if OLLAMA_HOST is set,
# else the keyless extractive answerer (the app fully works with no keys).
LLM_PROVIDER=auto
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- API ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# If set, POST /api/ingest/jobs requires the X-Admin-Token header
# ADMIN_TOKEN=change-me

# --- Ingestion ------------------------------------------------------------------------
ARXIV_DELAY_SECONDS=3.0
ARXIV_USER_AGENT=PaperPilot/0.1 (mailto:you@example.com)
